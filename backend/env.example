# Copy to .env and adjust values. Never commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fir_blockchain?schema=public"

JWT_SECRET="replace_with_a_long_random_string_at_least_16_chars"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Hardhat local node (run: cd contracts && npx hardhat node)
RPC_URL="http://127.0.0.1:8545"
CHAIN_ID=31337

# After deploy, paste address from code/contracts/deployments/localhost/FIRAnchor.json
FIR_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# Dev account #0 private key on Hardhat's default accounts (local only — never reuse on mainnet)
SIGNER_PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
